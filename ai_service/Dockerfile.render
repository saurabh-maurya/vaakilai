# Slim AI-service image for Render's free tier (512MB RAM).
# Binds to Render's $PORT and runs 1 worker to fit memory (langchain/faiss/pinecone).
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
COPY --chown=appuser:appgroup . .

USER appuser

# Render provides $PORT; default 8001 for local runs. 1 worker fits 512MB.
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001} --workers 1"]
